# ==============================================================================
# ⚛️ FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# HOW TO GET THESE VALUES:
#
# 1. VITE_API_URL:
#    - URL of the Express backend API (typically http://localhost:5000/api)
#
# 2. VITE_CERTIFICATE_CONTRACT_ADDRESS:
#    - Address obtained after deploying the contract on Ethereum Sepolia
#    - Example: 0xcd70a18caa8b0cc879680e5f8B078577D64ce9de
#
# 3. VITE_SEPOLIA_RPC_URL:
#    - Infura: https://app.infura.io -> Create Key -> Copy Sepolia endpoint
#    - Alchemy: https://dashboard.alchemy.com
#    - Public: https://ethereum-sepolia-rpc.publicnode.com
#
# 4. VITE_SEPOLIA_CHAIN_ID:
#    - 11155111 (Sepolia network)
# ==============================================================================

VITE_API_URL=http://localhost:5000/api
VITE_CERTIFICATE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
VITE_SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"
VITE_SEPOLIA_CHAIN_ID=11155111
