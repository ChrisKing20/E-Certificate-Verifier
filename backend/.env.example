# ==============================================================================
# 🍃 BACKEND SERVER CONFIGURATION TEMPLATE
# ==============================================================================
# HOW TO GET THESE VALUES:
#
# 1. PORT:
#    - Default: 5000
#    - Note for macOS users: If port 5000 is occupied by ControlCenter (AirPlay),
#      turn off AirPlay Receiver in macOS System Settings > General > AirDrop & AirPlay,
#      or set PORT=5001 here and update VITE_API_URL in frontend/.env.
#
# 2. MONGODB_URI:
#    - Sign up at https://cloud.mongodb.com
#    - Create a free M0 Cluster
#    - Go to 'Database Access' -> Add New Database User (username & password)
#    - Go to 'Network Access' -> Add IP Address -> 0.0.0.0/0 (Allow from anywhere)
#    - Go to 'Clusters' -> Click 'Connect' -> 'Drivers' (Node.js) -> Copy connection URI:
#      mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
#
# 3. JWT_SECRET:
#    - Random secret for signing admin login sessions.
#    - Generate with: `openssl rand -hex 32`
#
# 4. CONTRACT_ADDRESS:
#    - Deployed smart contract address from `blockchain/` folder
#    - Example Sepolia contract: 0xcd70a18caa8b0cc879680e5f8B078577D64ce9de
#
# 5. SEPOLIA_RPC_URL:
#    - RPC endpoint on Infura (https://infura.io), Alchemy (https://alchemy.com),
#      or public node: https://ethereum-sepolia-rpc.publicnode.com
# ==============================================================================

PORT=5000
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecertificate?retryWrites=true&w=majority"
JWT_SECRET="ecert-verifier-super-secret-jwt-key-2026-phase2"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ── IPFS Storage Provider Setup (Pinata / IPFS Gateway) ──
# Sign up at https://app.pinata.cloud/ to get API Keys / JWT
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"
IPFS_JWT="YOUR_PINATA_JWT_TOKEN"
PINATA_API_KEY="YOUR_PINATA_API_KEY"
PINATA_SECRET_API_KEY="YOUR_PINATA_SECRET_KEY"

# ── Rate Limiting Controls ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Blockchain Integration (Ethereum Sepolia) ──
CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"

# ── Google OAuth Configuration ──
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
FRONTEND_URL="http://localhost:5173"

# ── Default Super Admin Setup ──
SUPER_ADMIN_EMAIL="superadmin@verifier.org"
SUPER_ADMIN_PASSWORD="SuperAdminSecret123!"
