{
  "name": "e-cert-verifier-backend",
  "version": "1.0.0",
  "description": "E-Certificate Verifier Node.js Express TypeScript MongoDB Mongoose Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "create-admin": "ts-node src/scripts/createAdmin.ts",
    "seed:superadmin": "ts-node src/scripts/seedSuperAdmin.ts",
    "seed-superadmin": "ts-node src/scripts/seedSuperAdmin.ts",
    "migrate-multitenant": "ts-node src/scripts/migrateMultiTenant.ts",
    "seed": "ts-node src/seed.ts",
    "migrate-ipfs": "ts-node src/scripts/migrateToIpfs.ts",
    "test": "jest --detectOpenHandles"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
